{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="Save" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="Back" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info">
      {{ help_webhook_url }}<br>
      Card/Bank/Wallet: <code>{{ merchant_webhook_url }}</code><br>
      Crypto: <code>{{ crypto_webhook_url }}</code>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_adeptix_api_key" value="{{ payment_adeptix_api_key }}" class="form-control" />
              <div class="form-text">{{ help_api_key }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_webhook_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_adeptix_webhook_secret" value="{{ payment_adeptix_webhook_secret }}" class="form-control" />
              <div class="form-text">{{ help_webhook_secret }}</div>
            </div>
          </div>

          <h4>{{ text_merchant }}</h4>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_provider }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_adeptix_provider" value="{{ payment_adeptix_provider|default('stripe') }}" class="form-control" />
              <div class="form-text">{{ help_provider }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_adeptix_merchant_order_status_id" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_adeptix_merchant_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_paid_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_adeptix_merchant_paid_status_id" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_adeptix_merchant_paid_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_adeptix_merchant_status" value="0" />
                <input type="checkbox" name="payment_adeptix_merchant_status" value="1" class="form-check-input"{% if payment_adeptix_merchant_status %} checked{% endif %} />
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_adeptix_merchant_sort_order" value="{{ payment_adeptix_merchant_sort_order }}" class="form-control" />
            </div>
          </div>

          <h4>{{ text_crypto }}</h4>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_crypto_chain }}</label>
            <div class="col-sm-10">
              <select name="payment_adeptix_crypto_chain" class="form-select">
                {% for chain in ['bsc', 'polygon', 'tron'] %}
                  <option value="{{ chain }}"{% if chain == payment_adeptix_crypto_chain %} selected{% endif %}>{{ chain }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_crypto_token }}</label>
            <div class="col-sm-10">
              <select name="payment_adeptix_crypto_token" class="form-select">
                {% for token in ['USDT', 'USDC'] %}
                  <option value="{{ token }}"{% if token == payment_adeptix_crypto_token %} selected{% endif %}>{{ token }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_adeptix_crypto_order_status_id" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_adeptix_crypto_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_paid_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_adeptix_crypto_paid_status_id" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_adeptix_crypto_paid_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_adeptix_crypto_status" value="0" />
                <input type="checkbox" name="payment_adeptix_crypto_status" value="1" class="form-check-input"{% if payment_adeptix_crypto_status %} checked{% endif %} />
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_adeptix_crypto_sort_order" value="{{ payment_adeptix_crypto_sort_order }}" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
